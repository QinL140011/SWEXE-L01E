<%= form_with(model: student) do |form| %>

  <% if student.errors.any? %>
    <div class="form-error-box">
      <strong><%= student.errors.count %>件のエラーがあります:</strong>
      <ul class="form-error-box__list">
        <% student.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, "学生名", class: "form-field__label" %>
    <%= form.text_field :name, class: "form-field__input" %>
    <% student.errors[:name].each do |msg| %>
      <span class="form-field__error"><%= msg %></span><br>
    <% end %>
  </div>

  <div class="form-field">
    <%= form.label :student_number, "学生番号", class: "form-field__label" %>
    <%= form.text_field :student_number,
          placeholder: "10桁の数字",
          class: "form-field__input" %>
    <% student.errors[:student_number].each do |msg| %>
      <span class="form-field__error"><%= msg %></span><br>
    <% end %>
  </div>

  <div class="form-field">
    <%= form.label :course, "所属コース（任意）", class: "form-field__label" %>
    <%= form.text_field :course,
          placeholder: "未入力でも可",
          class: "form-field__input" %>
  </div>

  <div class="form-actions">
    <%= form.submit (student.new_record? ? "登録する" : "更新する"),
        class: "btn btn--primary" %>
    <%= link_to "キャンセル", students_path, class: "btn btn--secondary btn--cancel" %>
  </div>
<% end %>