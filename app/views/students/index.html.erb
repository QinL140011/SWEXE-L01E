<div class="page-header">
  <h1 class="page-header__title">学生一覧</h1>
  <%= link_to "＋ 新規登録", new_student_path, class: "btn btn--primary btn--small" %>
</div>

<% if @students.empty? %>
  <p class="empty-message">学生がまだ登録されていません。</p>
<% else %>
  <table class="students-table">
    <thead>
      <tr>
        <th>学生名</th>
        <th>学生番号</th>
        <th>所属コース</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.student_number %></td>
          <td><%= student.course.presence || "—" %></td>
          <td>
            <%= link_to "詳細", student %> |
            <%= link_to "編集", edit_student_path(student) %> |
            <%= link_to "削除", student,
                  data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                  class: "link--danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>