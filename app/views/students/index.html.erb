<h1>学生一覧</h1>

<%= link_to "新規登録", new_student_path %>

<table border="1" cellpadding="6" style="border-collapse: collapse; margin-top: 10px;">
  <thead>
    <tr>
      <th>学生名</th>
      <th>学生番号</th>
      <th>所属コース</th>
      <th colspan="3">操作</th>
    </tr>
  </thead>
  <tbody>
    <% @students.each do |student| %>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.student_number %></td>
        <td><%= student.course %></td>
        <td><%= link_to "詳細", student %></td>
        <td><%= link_to "編集", edit_student_path(student) %></td>
        <td><%= link_to "削除", student, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>