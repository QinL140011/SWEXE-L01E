<div class="breadcrumb">
  <%= link_to "学生一覧", students_path %> &gt; <%= @student.name %>
</div>

<h1>学生詳細</h1>

<div class="card card--spaced">
  <p class="detail-row">
    <strong class="detail-row__label">学生名</strong>
    <%= @student.name %>
  </p>
  <p class="detail-row">
    <strong class="detail-row__label">学生番号</strong>
    <%= @student.student_number %>
  </p>
  <p class="detail-row">
    <strong class="detail-row__label">所属コース</strong>
    <%= @student.course.presence || "—" %>
  </p>
</div>

<div>
  <%= link_to "編集", edit_student_path(@student) %> |
  <%= link_to "一覧に戻る", students_path %>
</div>